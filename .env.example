APP_ENV=development
LOG_LEVEL=INFO
USE_DATABASE=true
AUTO_CREATE_SCHEMA=true

# Fill these in locally; .env is gitignored. Use URL-encoded credentials in DATABASE_URL.
POSTGRES_USER=bioagentx
POSTGRES_PASSWORD=
POSTGRES_DB=bioagentx
POSTGRES_PORT=5433
APP_PORT=8080
DATABASE_URL=

# Database connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

EMBEDDING_DIMENSIONS=64
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=2048
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=40
